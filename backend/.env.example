# --- Django Settings ---
SECRET_KEY=django-insecure-template-secret-key-prod-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,host.docker.internal,django-template-backend,*
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Superadmin Defaults (Used by python manage.py init_admin on first-time build) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- PostgreSQL Database ---
POSTGRES_DB=ai_system_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Hermes Gateway Target (for reverse health ping) ---
HERMES_GATEWAY_URL=http://host.docker.internal:8643
HERMES_API_KEY=
API_SERVER_KEY=
HERMES_REQUEST_TIMEOUT=120
