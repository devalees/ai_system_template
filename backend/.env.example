# --- Django Settings ---
SECRET_KEY=django-insecure-template-secret-key-prod-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,host.docker.internal

# --- PostgreSQL Database ---
POSTGRES_DB=ai_system_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Hermes Gateway Target (for reverse health ping) ---
HERMES_GATEWAY_URL=http://host.docker.internal:8643
HERMES_API_KEY=
API_SERVER_KEY=
