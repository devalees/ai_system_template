# ==============================================================================
# Sovereign Headless Backend Platform — Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=true

# --- HTTP / ASGI Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- PostgreSQL Database (Asyncpg) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign_secret_pass_2026
POSTGRES_DB=sovereign_db
DATABASE_URL=postgresql+asyncpg://sovereign:sovereign_secret_pass_2026@postgres:5432/sovereign_db

# --- Redis & Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=sovereign_jwt_secret_dev_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Agent Ecosystem (Nous Hermes Agent & Langfuse) ---
HERMES_GATEWAY_URL=http://host.docker.internal:8643
HERMES_API_KEY=hermes_agent_secret_key_prod_2026_audit
LANGFUSE_HOST=http://host.docker.internal:3100

# --- Filestore ---
FILESTORE_PATH=/app/filestore
