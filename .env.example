# ==============================================================================
# AI System Template — Environment Configuration
# ==============================================================================

# --- Django Core Settings ---
SECRET_KEY=django-insecure-change-this-in-production-template-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# --- PostgreSQL Database ---
POSTGRES_DB=ai_system_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis Cache / Broker ---
REDIS_URL=redis://redis:6379/0

# --- Hermes Agent Gateway & Server ---
HERMES_IMAGE=hermes-agent:local
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=hermes_agent_template_secret_2026
HERMES_HOME=/root/.hermes

# --- Model Provider API Keys (Fill as needed) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Inter-Service Communication URLs ---
DJANGO_API_URL=http://backend:8000/api
HERMES_GATEWAY_URL=http://hermes:8642
